DRONE_MODE=REAL
REAL_HARDWARE_CONFIRMATION=YES

# ── AI Provider Configuration ────────────────────────────────────────────────
# OpenRouter (primary provider) — get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Groq (fallback provider) — get key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# OpenRouter budget threshold in USD (auto-switches to Groq when reached)
OPENROUTER_BUDGET=1.00
